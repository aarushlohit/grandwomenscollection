rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn() && request.auth.token.role is string && request.auth.token.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin', 'super_admin']);
    }

    function hasOperationsAccess() {
      return hasRole(['staff', 'admin', 'soc_admin', 'super_admin']);
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || hasOperationsAccess();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || hasOperationsAccess();
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if resource.data.active == true || hasOperationsAccess();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if resource.data.public == true || hasOperationsAccess();
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || hasOperationsAccess();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if owns(userId) || hasOperationsAccess();
      allow create, delete: if false;
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'defaultAddress', 'preferences', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && isTimestamp(request.resource.data.updatedAt);
    }

    match /wishlists/{userId} {
      allow read: if owns(userId) || hasOperationsAccess();
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 100
        && isTimestamp(request.resource.data.updatedAt);
      allow delete: if owns(userId);
    }

    match /carts/{userId} {
      allow read: if owns(userId) || hasOperationsAccess();
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
        && isTimestamp(request.resource.data.updatedAt);
      allow delete: if owns(userId);
    }

    match /orders/{orderId} {
      allow read: if hasOperationsAccess() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read, write: if false;
    }

    match /auditLogs/{eventId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /paymentLogs/{logId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /usageMetrics/{metricId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /systemHealth/{healthId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /backupJobs/{jobId} {
      allow read: if hasOperationsAccess();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
