rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['admin', 'soc_admin'];
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId},
          /settings/{settingId},
          /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId},
          /wishlist/{userId},
          /cart/{userId} {
      allow read, write: if owns(userId) || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /notifications/{notificationId},
          /analytics/{eventId},
          /auditLogs/{eventId},
          /securityEvents/{eventId},
          /honeypot/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn() || request.auth == null;
      allow update, delete: if isAdmin();
    }
  }
}
